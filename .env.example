# Copy to .env and adjust.
PUID=1000
PGID=1000
TZ=UTC
# Host folder where episodes are saved (mounted on the app's default download folder)
DOWNLOAD_DIR=./downloads
# Address the web UI is published on. 0.0.0.0 = whole LAN. The UI has no login!
BIND_IP=127.0.0.1
# Hostnames you open the UI from besides localhost, comma-separated (LAN IP, reverse-proxy domain)
ALLOWED_ORIGINS=
